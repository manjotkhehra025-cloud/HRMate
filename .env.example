# ============================================================
# HRMate environment variables
# Copy to `.env` and adjust for your deployment.
# ============================================================

# --- Domain / WebAuthn (passkeys) ---
# HRMate is served ONLY from gdfoods.duckdns.org.
# (hr.flavorflow.co.in is reserved for the new app — do not use it here.)
# The public domain the app is served from (required for passkey login to work)
HRMATE_DOMAIN=gdfoods.duckdns.org
# WebAuthn Relying Party ID — use your domain (or "localhost" for local dev)
HRMATE_RP_ID=gdfoods.duckdns.org
# Origin the browser sees — must match the RP_ID origin exactly
HRMATE_ORIGIN=https://gdfoods.duckdns.org

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
# If unset, a bundled demo key pair is used (fine for testing, replace for production).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Database ---
# Optional: override the SQLite file location (defaults to ./data/hrmate.db)
HRMATE_DB=/app/data/hrmate.db

# --- Mobile Native JWT Secret ---
MOBILE_JWT_SECRET=hrmate_mobile_jwt_production_secret_2026_gdfoods_khadur_sahib

