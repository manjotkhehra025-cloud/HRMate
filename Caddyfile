# HRMate — reverse proxy with automatic HTTPS (Let's Encrypt)
gdfoods.duckdns.org {
	tls {
		issuer acme {
			# Prefer Let's Encrypt's cross-signed chain (ISRG Root X1), which
			# every Android device trusts since 2016. The default Generation Y
			# chain (YE2 -> ISRG Root YE) breaks Android clients.
			preferred_chains ISRG Root X1
		}
	}

	encode gzip

	# Proxy all traffic to the Next.js app
	reverse_proxy hrmate:3000

	# WebSocket support (for future live features)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
