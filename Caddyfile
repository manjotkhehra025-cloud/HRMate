# HRMate — reverse proxy with automatic HTTPS (Let's Encrypt)
gdfoods.duckdns.org {
	tls {
		issuer acme {
			# Let's Encrypt's new "Generation Y" chain (root ISRG Root YE) is not
			# yet trusted by Android devices, causing certificate errors there.
			# Prefer the cross-signed chain rooted at ISRG Root X1 (trusted on
			# Android since 2016).
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}

	encode gzip

	# Google Search Console (and similar) HTML verification files.
	# Drop google*.html into ./verify/ — no app rebuild needed.
	handle /google*.html {
		root * /srv/verify
		header Content-Type "text/html; charset=utf-8"
		file_server
	}

	# Proxy all other traffic to the Next.js app
	handle {
		reverse_proxy hrmate:3000
	}

	# WebSocket support (for future live features)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
